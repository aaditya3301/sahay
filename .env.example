# Local development (copy to .env). Secrets never go in git.
ENV=dev
PUBLIC_BASE_URL=http://localhost:8080
GCP_PROJECT=project-422405a7-b76c-49df-b1c
VERTEX_LOCATION=global
EMBED_LOCATION=asia-south1
MEDIA_BUCKET=sahay-media-536440059442
# Local Postgres from docker-compose (Cloud SQL is used in the cloud via DB_INSTANCE)
DB_HOST=localhost
DB_PORT=5433
DB_NAME=sahay
DB_USER=sahay_app
DB_PASSWORD=change-me
DB_OWNER_USER=postgres
DB_OWNER_PASSWORD=change-me
JWT_SECRET=change-me
SEED_PASSWORD=sahay-demo
# Optional channels (leave empty to use the in-app simulator)
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
FIRECRAWL_API_KEY=

# Voice agent: LiveKit (free Cloud project) + Sarvam (STT/TTS). LIVEKIT_URL turns the worker on.
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
LIVEKIT_SIP_TRUNK_ID=
SARVAM_API_KEY=
# Shared by the API and the worker; inbound phone calls use it with the dialled number to find the business
VOICE_PLATFORM_KEY=

# Email: Brevo (free plan: 300 emails/day). EMAIL_FROM must be a sender verified in Brevo.
BREVO_API_KEY=
EMAIL_FROM=
# Brevo inbound parsing domain (MX → inbound1/inbound2.sendinblue.com); each business gets <slug>@<domain>
INBOUND_EMAIL_DOMAIN=
# Sent back by Brevo as a bearer token on /webhooks/email and /webhooks/email/events
EMAIL_WEBHOOK_TOKEN=
# Legacy sender, still honoured if set
RESEND_API_KEY=

# Telegram bot (customers' phone channel while WhatsApp waits for Meta verification). Token from @BotFather.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
# Local dev without a public URL: read messages by polling instead of the webhook
TELEGRAM_POLLING=

# Payments on the demo storefronts: Cashfree (merchant.cashfree.com → Developers → API keys)
CASHFREE_APP_ID=
CASHFREE_SECRET_KEY=
CASHFREE_API_URL=https://sandbox.cashfree.com/pg
CASHFREE_API_VERSION=2025-01-01
CASHFREE_ENV=sandbox
# Sandbox demo: returning from the payment page confirms the order even without a test payment
PAYMENTS_CONFIRM_ON_RETURN=true
